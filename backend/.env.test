# Loaded by tests/loadEnv.ts. Points at a disposable local database — the test
# suite TRUNCATEs every table between tests. DATABASE_URL is deliberately not
# used in tests (see config/data-source.ts), so .env can never leak in here.
PORT=4001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecom_test
JWT_SECRET=test_secret_do_not_use_in_prod
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Dummy key: only used to sign/verify webhook payloads in tests/payments.test.ts.
# The suite never calls Chargily's API.
CHARGILY_API_KEY=test_sk_dummy_key_for_webhook_signatures

# Uploads/email are left unconfigured on purpose — tests never hit Cloudinary
# or Resend; email sending is skipped gracefully (see services/email.ts).
