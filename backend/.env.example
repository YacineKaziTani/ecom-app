PORT=4000
CLIENT_URL=http://localhost:5173

# --- Production (set these on the server, not locally) ---
# NODE_ENV=production   # required: Secure cookies, migrations on boot, strict config checks
# TRUST_PROXY=2         # proxy hops in front of the app: Vercel /api rewrite → Render = 2
# RUN_MIGRATIONS=true   # default in production; set false if you migrate in a separate step
# LOG_LEVEL=info        # pino level: debug | info | warn | error

# How long an unpaid card order holds its stock before it's cancelled automatically
# (pay-on-delivery orders hold it until an admin confirms or cancels them).
ORDER_RESERVATION_MINUTES=30

# Marketplace commission (%) on every sale, deducted from shop payouts.
PLATFORM_COMMISSION_PERCENT=0

# Shop owners are emailed when a checkout leaves a product (or one of its
# options) at or below this many units. 0 = only when it sells out.
LOW_STOCK_THRESHOLD=3

# Encrypts admins' 2FA secrets at rest. Set once to a long random value and never change it.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# Database — either a full connection string (e.g. Neon; SSL is enabled for it)...
DATABASE_URL=
# ...or discrete settings for a local Postgres (used when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecom
# DB_SSL=true        # only needed for a remote DB configured via the DB_* vars
# DB_LOGGING=true    # log every SQL query (errors are always logged)

# Auth
JWT_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (Resend). Leave RESEND_API_KEY empty to skip sending.
RESEND_API_KEY=
MAIL_FROM="Artisan Shop <onboarding@resend.dev>"

# Payments (Chargily Pay)
CHARGILY_API_KEY=
CHARGILY_MODE=test
CHARGILY_LOCALE=ar
# CHARGILY_BASE_URL=  # optional override; defaults from CHARGILY_MODE
# Must be a PUBLICLY reachable URL pointing at this backend, so Chargily's
# servers can deliver the payment webhook to it. In local dev, run a tunnel
# (e.g. `ngrok http 4000`) and put that https URL here — localhost will not work.
API_PUBLIC_URL=http://localhost:4000

# SMS (pay-on-delivery phone check). Leave SMS_PROVIDER empty to turn SMS off.
# twilio = real texts; log = print codes to the server log (development only —
# refused in production).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: a Twilio number in TWILIO_FROM, or a messaging service.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Pay-on-delivery orders from this total (DA, delivery included) must confirm
# the phone number with a texted code. Empty = never (needs SMS_PROVIDER).
COD_OTP_MIN_TOTAL=

# Error tracking (optional). Without it nothing is loaded.
SENTRY_DSN=
