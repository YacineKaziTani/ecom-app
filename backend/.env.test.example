DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecom_test
JWT_SECRET=test_secret_do_not_use_in_prod
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Payments/uploads/email are left unconfigured on purpose — tests never hit
# Cloudinary, Chargily, or a real SMTP server. Code paths that depend on these
# either skip gracefully (email — see services/email.ts) or simply aren't
# exercised by the current test suite (Cloudinary uploads, live Chargily calls).
